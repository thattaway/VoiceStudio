# Copy to .env (git-ignored) and fill in.

# Required. The web UI asks for this once per browser. Generate one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
OMNIVOICE_API_KEY=

# Where to listen. 0.0.0.0 = reachable from other devices (LAN / Tailscale);
# 127.0.0.1 = this machine only.
BIND=0.0.0.0
PORT=3900

# Optional: Hugging Face token, only needed for gated models.
HF_TOKEN=

# Usage analytics are off by default here. Set to 0 to allow the opt-in prompt.
OMNIVOICE_ANALYTICS_DISABLED=1
